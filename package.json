{
  "name": "stoned-goose-productions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "(npm run feeds:all || true) && npm run feeds:validate && (npm run sync || true) && npm run build:placeholders",
    "build:placeholders": "tsx scripts/build-placeholders.ts",
    "build": "next build",
    "postbuild": "tsx scripts/build-shows-feeds.ts && pagefind --site out --output-path out/pagefind",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "sync": "npm run sync:shows && npm run sync:facebook-events && npm run sync:fourthwall && npm run sync:patreon && npm run sync:open-mics",
    "sync:shows": "tsx scripts/sync-shows.ts",
    "sync:fourthwall": "tsx scripts/sync-fourthwall.ts",
    "sync:facebook-events": "tsx scripts/sync-facebook-events.ts",
    "sync:patreon": "tsx scripts/sync-patreon.ts",
    "sync:open-mics": "tsx scripts/sync-open-mics.ts",
    "feeds:instagram": "tsx scripts/feeds/fetch-instagram.ts",
    "feeds:youtube": "tsx scripts/feeds/fetch-youtube.ts",
    "feeds:facebook": "tsx scripts/feeds/fetch-facebook.ts",
    "feeds:all": "npm run feeds:instagram && npm run feeds:youtube && npm run feeds:facebook",
    "feeds:validate": "tsx scripts/feeds/validate-feeds.ts",
    "refresh:instagram-token": "tsx scripts/refresh-instagram-token.ts",
    "brand:generate": "tsx scripts/brand/generate-brand-assets.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "next lint --fix --file"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "feed": "^5.2.1",
    "framer-motion": "^11.11.17",
    "ics": "^3.12.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lenis": "^1.3.23",
    "next": "15.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.74.0",
    "schema-dts": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pagefind": "^1.5.2",
    "plaiceholder": "^3.0.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
