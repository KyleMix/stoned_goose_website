# Cloudflare Workers Static Assets and Netlify both honor this format.
# OG image routes from app/<route>/opengraph-image.tsx export as extensionless
# PNGs with a build hash suffix (e.g. /book/opengraph-image-14vkoy); force the
# correct MIME so social scrapers render the card. The wildcard spans slashes,
# so one rule covers nested routes like /book/<slug>/opengraph-image-<hash>.

/*/opengraph-image-*
  Content-Type: image/png

# Apple's app-site-association file has no extension by design, so a host with
# no rule for it serves application/octet-stream and iOS rejects the domain.
# Same class of problem as the OG routes above, same fix. Mirrored in
# vercel.json and deploy/nginx/site.conf so every host behaves identically.
#
# It must also not sit behind a redirect. Nothing in _redirects, vercel.json,
# or the nginx vhost touches /.well-known, and it needs to stay that way.

/.well-known/apple-app-site-association
  Content-Type: application/json

# assetlinks.json gets application/json from its extension on every host we
# deploy to. Stated anyway so the pair is obvious to the next reader.

/.well-known/assetlinks.json
  Content-Type: application/json
