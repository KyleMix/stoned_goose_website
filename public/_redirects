# Cloudflare Pages and Netlify both honor this format.
# Mirror of vercel.json `redirects` so both hosts behave identically.
# Old slug -> current IA target. 308 keeps method on POSTs.
#
# The CMS lives at /admin (static Sveltia app, public/admin/index.html) and
# uses hash routing, so it needs no redirect or rewrite here.

# About / team. /roster is the old name for this page: it was comedy-industry
# language for a page whose audience is not in the comedy industry. The arrow
# on /about used to point the other way.
/roster              /about                308
/roster/*            /about                308
/members             /about                308
/comedians           /about                308

# Media / watch
/media               /watch                308

# Booking funnel (everything collapsed to /book)
/book-a-show         /book                 308
/services            /book                 308
/submit              /book                 308
/comic-submissions   /book                 308

# Sponsors. /sponsor is a real page now rather than an anchor on /book, so
# /sponsorships points at it, and the old /sponsor -> /book#sponsors rule is
# gone: that URL resolves to a page of its own.
/sponsorships        /sponsor              308

# The Pacific Northwest open mic map is retired. /open-mics is the Log Cabin
# Monday mic now. The app pages that lived under this path (privacy, terms,
# delete-account) are deliberately NOT redirected: the Open Mic Explorer app is
# dead and never shipped, and pointing a privacy policy at a show listing would
# be worse than a 404. The 404 page steers "open mic" paths at /open-mics.
/open-mics/map       /open-mics            308
