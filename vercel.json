{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/roster",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/roster/:slug",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/members",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/comedians",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/media",
      "destination": "/watch",
      "permanent": true
    },
    {
      "source": "/book-a-show",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/submit",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/comic-submissions",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/sponsorships",
      "destination": "/sponsor",
      "permanent": true
    },
    {
      "source": "/open-mics/map",
      "destination": "/open-mics",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*/opengraph-image-:hash",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    }
  ]
}
